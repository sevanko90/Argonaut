<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argonaut.App"
             Name="Argonaut"
             RequestedThemeVariant="Default">
             <!-- "Default" follows the OS light/dark setting. Every custom color the app uses
                  is defined for both variants in Themes/AppColors.axaml (merged below) and
                  referenced via DynamicResource, so this is safe - MainWindow's theme-toggle
                  button can also override it explicitly at runtime (System/Light/Dark). -->

    <Application.Styles>
        <FluentTheme />
        <!-- Shared chrome stays lightweight: solid fills and existing Fluent templates. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppSansFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AppPrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,12" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E40AF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- A lesser action sitting beside a .primary one: same metrics so the pair lines up
             (Fluent's default padding is visibly shorter), only the emphasis differs. Keep the
             padding here in step with .primary above. -->
        <Style Selector="Button.secondary">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,12" />
        </Style>


        <!-- Control shape and fills come from the Fluent keys AppColors.axaml overrides
             (ControlCornerRadius, the 28px minimum heights, the fill and field brushes), so every
             stock control shares one look without a style here per control. -->
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Title-bar controls: borderless until hovered, as native toolbar items are, so the
             bar reads as one quiet strip rather than a row of boxes. ".tool" works on Button,
             ToggleButton and ComboBox alike; the content stays the control's own. -->
        <Style Selector=":is(Button).tool, ComboBox.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button).tool">
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.tool:pressed /template/ ContentPresenter, ToggleButton.tool:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlFillPressedBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="ComboBox.tool">
            <Setter Property="Padding" Value="8,4,0,4" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="ComboBox.tool /template/ PathIcon#DropDownGlyph">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="6,0,8,0" />
        </Style>
        <Style Selector="ComboBox.tool:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource AppHoverBackgroundBrush}" />
        </Style>

        <Style Selector=":is(Button).tool">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Tables (CSV, the array table): the palette's surfaces rather than Fluent's greys -
             rows on the content background, a header strip on the panel one. -->
        <Style Selector="TableView">
            <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}" />
        </Style>
        <Style Selector="TableViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>

        <!-- A hairline between groups of title-bar controls. -->
        <Style Selector="Border.toolseparator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        </Style>

        <!-- Popover surfaces (Hint options flyout, ...): card look consistent with the rest of
             the app (bordered, rounded, panel background) instead of Fluent's flat default. -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AppPopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="RadioButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBackgroundBrush}" />
        </Style>
        <!-- Fluent's RadioButton indicator is fixed at 20px with no exposed size resource;
             shrink the named template parts directly so it reads at the app's compact scale. -->
        <Style Selector="RadioButton /template/ Ellipse#OuterEllipse, RadioButton /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="RadioButton /template/ Ellipse#CheckGlyph">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
        </Style>

        <!-- Shared chromeless icon button (toolbar close, find bar arrows, theme toggle...).
             Spacing follows the app's 4-based scale (4/8/12/16); "compact" is the tighter
             variant for dense bars like the JSON path bar and status bar. -->
        <Style Selector="Button.iconbutton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.iconbutton.compact">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Button.iconbutton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.iconbutton:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.iconbutton:disabled /template/ ContentPresenter, Button.tool:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tool:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Text-styled button used for inline actions (recent-file entries, a failure
             location that jumps to the raw viewer). -->
        <Style Selector="Button.linklike">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.linklike:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentHoverBrush}" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Argonaut/Themes/AppColors.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppMonoFontFamily">Consolas, 'SF Mono', Menlo, Monaco, 'Cascadia Code', 'Courier New', monospace</FontFamily>
            <FontFamily x:Key="AppSansFontFamily">fonts:Inter#Inter</FontFamily>

            <!-- The font content views actually render with (JSON tree, NDJSON lines, CSV cells,
                 find box). Consumed via DynamicResource; the status bar's font toggle swaps this
                 entry at runtime between the mono and sans families above, re-fonting all views
                 live (same mechanism as the theme brushes). -->
            <x:Double x:Key="AppContentFontSize">12</x:Double>
            <FontFamily x:Key="AppContentFontFamily">Consolas, 'SF Mono', Menlo, Monaco, 'Cascadia Code', 'Courier New', monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>