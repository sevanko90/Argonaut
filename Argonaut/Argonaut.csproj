<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Argonaut</RootNamespace>
    <ApplicationIcon>Assets\Icon\argonaut.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The Mac App Store build: `dotnet publish -p:MacAppStore=true`. Code the sandbox does not
       allow is compiled out under MAC_APP_STORE (see Shell/Launching/SystemLaunchers). -->
  <PropertyGroup Condition="'$(MacAppStore)' == 'true'">
    <DefineConstants>$(DefineConstants);MAC_APP_STORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Ksyrt, the Kaitai Struct runtime (github.com/sevanko90/ksyrt), developed alongside the app.
       Locally it is the checkout beside this one, as a project reference, so `dotnet run` builds
       its current state and the debugger steps into it. In CI (GitHub Actions sets GITHUB_ACTIONS)
       or without that checkout it is the package, restored from the GitHub Packages feed the
       workflows add. KsyrtVersion is the CI package an edit to Ksyrt is published as: bump it when
       the app needs a newer Ksyrt, or CI builds against the old one. -->
  <PropertyGroup>
    <KsyrtVersion>0.1.0-ci.2</KsyrtVersion>
    <KsyrtProject>$(MSBuildThisFileDirectory)..\..\ksyrt\Ksyrt\Ksyrt.csproj</KsyrtProject>
    <KsyrtFromProject Condition="'$(KsyrtFromProject)' == '' and '$(GITHUB_ACTIONS)' != 'true' and Exists('$(KsyrtProject)')">true</KsyrtFromProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(KsyrtFromProject)' == 'true'">
    <ProjectReference Include="$(KsyrtProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(KsyrtFromProject)' != 'true'">
    <PackageReference Include="Ksyrt" Version="$(KsyrtVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schemas the app ships with; JsonSchemaCatalog enumerates them from the output folder. -->
    <Content Include="Schemas\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Preset recipes; RecipeFolderStore enumerates them from the output folder. -->
    <Content Include="Recipes\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unicode character names, generated by scripts/make-unicode-names.py and read by
         UnicodeNames. Embedded compressed (271KB) and inflated on first lookup, never at startup. -->
    <EmbeddedResource Include="Assets\Unicode\UnicodeNames.deflate" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argonaut's own licence and the notices for everything it ships, generated by
         scripts/make-third-party-notices.py. Embedded for the About box's notices window (read
         only when opened) and copied beside the binaries, since the licences require the notices
         to travel with every copy. -->
    <EmbeddedResource Include="..\LICENSE" LogicalName="Argonaut.LICENSE" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.txt" LogicalName="Argonaut.THIRD-PARTY-NOTICES.txt" />
    <None Include="..\LICENSE;..\THIRD-PARTY-NOTICES.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Argonaut.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The internals inspector (Cmd/Ctrl+Shift+D) is a development tool and is not built at all
         outside Debug, so there is nothing shipped to hide behind a setting. It is written in
         code rather than XAML precisely so this one rule is enough - a .axaml file would need
         excluding from AvaloniaResource too, and two rules can disagree. MainWindow's call site
         is inside #if DEBUG to match. -->
    <Compile Remove="Diagnostics\**" Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Ui\Find\FindBar.axaml.cs">
      <DependentUpon>FindBar.axaml</DependentUpon>
    </Compile>
    <Compile Update="Features\Json\JsonToolbarView.axaml.cs">
      <DependentUpon>JsonToolbarView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
