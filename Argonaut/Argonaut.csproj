<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Argonaut</RootNamespace>
    <ApplicationIcon>Assets\Icon\argonaut.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Where this build is distributed, which decides whether it can update itself. GitHub (the
         default) self-updates through Velopack. AppStore ships no self-update at all, because
         store policy forbids it: no Velopack package, no Infrastructure\Updates\Velopack code,
         and third-party notices generated without Velopack's section. Choose with
         -p:DistributionChannel=AppStore (see scripts/package-macos-appstore.sh); the updater
         itself is picked in AppUpdaters. -->
    <DistributionChannel Condition="'$(DistributionChannel)' == ''">GitHub</DistributionChannel>
    <DefineConstants Condition="'$(DistributionChannel)' == 'GitHub'">$(DefineConstants);SELF_UPDATE</DefineConstants>
    <ThirdPartyNoticesFile Condition="'$(DistributionChannel)' == 'GitHub'">..\THIRD-PARTY-NOTICES.txt</ThirdPartyNoticesFile>
    <ThirdPartyNoticesFile Condition="'$(DistributionChannel)' != 'GitHub'">..\THIRD-PARTY-NOTICES.appstore.txt</ThirdPartyNoticesFile>
  </PropertyGroup>

  <Target Name="ValidateDistributionChannel" BeforeTargets="BeforeBuild"
          Condition="'$(DistributionChannel)' != 'GitHub' And '$(DistributionChannel)' != 'AppStore'">
    <Error Text="DistributionChannel must be GitHub or AppStore, not '$(DistributionChannel)'." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(DistributionChannel)' == 'GitHub'">
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(DistributionChannel)' != 'GitHub'">
    <!-- The only code that may name a Velopack type; see AppUpdaters. -->
    <Compile Remove="Infrastructure\Updates\Velopack\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schemas the app ships with; JsonSchemaCatalog enumerates them from the output folder. -->
    <Content Include="Schemas\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unicode character names, generated by scripts/make-unicode-names.py and read by
         UnicodeNames. Embedded compressed (271KB) and inflated on first lookup, never at startup. -->
    <EmbeddedResource Include="Assets\Unicode\UnicodeNames.deflate" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argonaut's own licence and the notices for everything it ships, generated by
         scripts/make-third-party-notices.py. Embedded for the About box's notices window (read
         only when opened) and copied beside the binaries, since the licences require the notices
         to travel with every copy. Each distribution channel has its own notices file, embedded and
         copied under the one name LicenseNotices reads. -->
    <EmbeddedResource Include="..\LICENSE" LogicalName="Argonaut.LICENSE" />
    <EmbeddedResource Include="$(ThirdPartyNoticesFile)" LogicalName="Argonaut.THIRD-PARTY-NOTICES.txt" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(ThirdPartyNoticesFile)" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Argonaut.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Features\Search\FindBar.axaml.cs">
      <DependentUpon>FindBar.axaml</DependentUpon>
    </Compile>
    <Compile Update="Features\Json\JsonToolbarView.axaml.cs">
      <DependentUpon>JsonToolbarView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
