<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:csv="clr-namespace:Argonaut.Features.Csv"
             x:Class="Argonaut.Features.Csv.CsvView"
             x:DataType="csv:CsvViewModel">
    <!-- The grid is a TableView (Avalonia 12.1), which owns the sticky header, its
         horizontal-scroll tracking and the column resizer - all of which used to be built here
         by hand. Columns are absent from this markup because their count and names are data:
         TableGridColumns builds them in code-behind from the view model's CsvStructure, and
         carries the find-term binding into each cell so matches still highlight. -->
    <Border BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource AppWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="8,6"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource AppPanelBackgroundBrush}">
                <CheckBox Content="First row is header"
                          IsChecked="{Binding IsHeaderRow}"
                          FontSize="12" />
            </Border>

            <TableView Grid.Row="1"
                       x:Name="Table"
                       ItemsSource="{Binding Rows}"
                       SelectionMode="Single"
                       CanUserResizeColumns="True"
                       Padding="0">
                <TableView.Styles>
                    <Style Selector="TableViewRow">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="24" />
                    </Style>
                    <Style Selector="TableViewColumnHeader">
                        <Setter Property="FontFamily" Value="{DynamicResource AppContentFontFamily}" />
                        <Setter Property="FontSize" Value="{DynamicResource AppContentFontSize}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </TableView.Styles>
            </TableView>
        </Grid>
    </Border>
</UserControl>
