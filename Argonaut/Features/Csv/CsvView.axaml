<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:csv="clr-namespace:Argonaut.Features.Csv"
             xmlns:grid="clr-namespace:Argonaut.Ui.TableGrid"
             x:Class="Argonaut.Features.Csv.CsvView"
             x:DataType="csv:CsvViewModel">
    <!-- The grid draws itself (TableSurface): the column names pinned across the top, the line
         gutter pinned down the left, and only the cells on screen. Its scrollbars drive it through
         RowScrollBars, as every self-drawn view's do. Rows and Structure throw until the document
         has loaded, so the code-behind hands them over rather than binding them. -->
    <Border BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0"
            Background="{DynamicResource AppWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Height="30"
                    Padding="10,0"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource AppPanelBackgroundBrush}">
                <CheckBox Content="First row is header"
                          IsChecked="{Binding IsHeaderRow}"
                          MinHeight="0"
                          VerticalAlignment="Center"
                          FontSize="11" />
            </Border>

            <Grid Grid.Row="1" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
                <grid:TableSurface x:Name="Surface"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Background="{DynamicResource AppWindowBackgroundBrush}"
                                   HeaderBackground="{DynamicResource AppPanelBackgroundBrush}"
                                   RowBandBrush="{DynamicResource AppPanelBackgroundBrush}"
                                   GridLineBrush="{DynamicResource AppBorderBrush}"
                                   FontFamily="{DynamicResource AppContentFontFamily}"
                                   FontSize="{DynamicResource AppContentFontSize}"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   GutterForeground="{DynamicResource AppMutedTextBrush}"
                                   HighlightBrush="{DynamicResource AppSearchMatchBrush}"
                                   HighlightEdgeBrush="{DynamicResource AppSearchMatchEdgeBrush}"
                                   CurrentHighlightBrush="{DynamicResource AppSearchCurrentBrush}"
                                   CurrentHighlightForeground="{DynamicResource AppSearchCurrentTextBrush}"
                                   SelectionBrush="{DynamicResource AppTextSelectionBrush}"
                                   LineNumbering="{Binding LineNumbering}"
                                   WidestGutterLabel="{Binding WidestGutterLabel}"
                                   HighlightTerm="{Binding HighlightTerm}" />

                <ScrollBar x:Name="VerticalScrollBar"
                           Grid.Row="0"
                           Grid.Column="1"
                           Orientation="Vertical"
                           IsVisible="False"
                           Minimum="0" />

                <ScrollBar x:Name="PanScrollBar"
                           Grid.Row="1"
                           Grid.Column="0"
                           Orientation="Horizontal"
                           AllowAutoHide="False"
                           IsVisible="False"
                           Minimum="0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
