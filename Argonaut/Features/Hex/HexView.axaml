<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hex="clr-namespace:Argonaut.Features.Hex"
             xmlns:values="clr-namespace:Argonaut.Features.Hex.Values"
             xmlns:icons="clr-namespace:Argonaut.Ui.Icons"
             xmlns:structs="clr-namespace:Argonaut.Features.Hex.Structs"
             xmlns:tree="clr-namespace:Argonaut.Ui.Tree"
             x:Class="Argonaut.Features.Hex.HexView"
             x:DataType="hex:HexViewModel">
    <UserControl.Styles>
        <!-- The caret's position reads as status text, and shows it can be clicked on hover. -->
        <Style Selector="Button.position">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.position:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
        <!-- The Values tab: muted labels, values in the dump's monospaced face. -->
        <Style Selector="TextBlock.valuehead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.valuename">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip.Tip" Value="{Binding $self.Text}" />
        </Style>
        <Style Selector="Border.valuerow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0,3" />
        </Style>
        <Style Selector="Border.valuerow:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHoverBackgroundBrush}" />
        </Style>
        <!-- The byte order switch: two small chips in the panel's header, the chosen one in
             the accent. -->
        <Style Selector="ToggleButton.order">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.order:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.order:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppWindowBackgroundBrush}" />
        </Style>
        <Style Selector="Button.orderreset">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="Button.orderreset:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.orderreset:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="TextBlock.value:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <!-- The side panel's tabs: plain words, the one shown in the text colour and semibold,
             the others muted until hovered. -->
        <Style Selector="RadioButton.paneltab">
            <Setter Property="FontSize" Value="{DynamicResource AppContentFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.paneltab:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="RadioButton.paneltab:checked">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ToggleButton.pin">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.pin:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppWindowBackgroundBrush}" />
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource AppWindowBackgroundBrush}" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto,Auto" ColumnDefinitions="*,Auto,Auto">
            <!-- Draws the rows on screen itself; RowScrollBars drives the two bars, as for every
                 self-drawn view. -->
            <hex:HexSurface x:Name="Surface"
                            Background="{DynamicResource AppWindowBackgroundBrush}"
                            FontFamily="{DynamicResource AppMonoFontFamily}"
                            FontSize="{DynamicResource AppContentFontSize}"
                            Foreground="{DynamicResource AppTextBrush}"
                            GutterForeground="{DynamicResource AppMutedTextBrush}"
                            OtherByteForeground="{DynamicResource AppJsonNumberBrush}"
                            ZeroByteForeground="{DynamicResource AppSubtleIconBrush}"
                            HeaderLineBrush="{DynamicResource AppSubtleIconBrush}"
                            PanelBackground="{DynamicResource AppChipBrush}"
                            DividerBrush="{DynamicResource AppBorderBrush}"
                            ByteMarkBrush="{DynamicResource AppAccentBrush}"
                            ByteMarkForeground="{DynamicResource AppWindowBackgroundBrush}"
                            RowMarkBrush="{DynamicResource AppHoverBackgroundBrush}"
                            SelectionBrush="{DynamicResource AppTextSelectionBrush}"
                            GroupSize="{Binding GroupSize}"
                            ReadsUtf8="{Binding ReadsUtf8}"
                            HighlightRange="{Binding Values.HighlightedRange}" />

            <ScrollBar x:Name="VerticalScrollBar"
                       Grid.Column="1"
                       Orientation="Vertical"
                       IsVisible="False"
                       Minimum="0" />

            <ScrollBar x:Name="PanScrollBar"
                       Grid.Row="1"
                       Orientation="Horizontal"
                       AllowAutoHide="False"
                       IsVisible="False"
                       Minimum="0" />

            <!-- The side panel: what the bytes at the caret read as - the standard readings on the
                 Values tab, a pasted struct on the Struct tab, its definition on the Structures
                 tab. Sized from the window, never from what it shows, so the dump never shifts:
                 it takes what the dump does not use, and keeps its minimum when the window is
                 narrow (HexView.FitSidePanel). -->
            <Border x:Name="SidePanel"
                    Grid.Column="2"
                    Grid.RowSpan="2"
                    IsVisible="{Binding ShowsSidePanel}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource AppPanelBackgroundBrush}">
                <DockPanel>
                    <!-- A header as the dump's: the tabs, and the byte order every tab reads in -
                         one at a time, this machine's until another is chosen, and remembered;
                         the reset goes back to this machine's. -->
                    <Border DockPanel.Dock="Top"
                            Height="24"
                            Padding="8,0"
                            Background="{DynamicResource AppChipBrush}"
                            BorderBrush="{DynamicResource AppSubtleIconBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton Classes="paneltab" GroupName="HexPanelTabs" Content="Values" IsChecked="{Binding ShowsValuesTab}" />
                                <RadioButton Classes="paneltab" GroupName="HexPanelTabs" Content="Structures" IsChecked="{Binding ShowsStructuresTab}" />
                                <RadioButton Classes="paneltab" GroupName="HexPanelTabs" Content="Struct" IsChecked="{Binding ShowsStructTab}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center"
                                        DataContext="{Binding Values}"
                                        x:DataType="values:HexValuesViewModel">
                                <ToggleButton Classes="order"
                                              Content="LE"
                                              IsChecked="{Binding IsLittleEndian, Mode=TwoWay}"
                                              ToolTip.Tip="Little-endian: least significant byte first" />
                                <ToggleButton Classes="order"
                                              Content="BE"
                                              IsChecked="{Binding IsBigEndian, Mode=TwoWay}"
                                              ToolTip.Tip="Big-endian: most significant byte first" />
                                <Button Classes="orderreset"
                                        Click="OnUseSystemOrder"
                                        IsEnabled="{Binding !IsSystemOrder}"
                                        ToolTip.Tip="{x:Static values:HexValuesViewModel.SystemOrderText}"
                                        ToolTip.ShowOnDisabled="True">
                                    <icons:LucideIcon Data="{StaticResource Icon.Reset}" Size="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Panel>
                        <!-- Values: the selection start read every standard way. -->
                        <DockPanel IsVisible="{Binding ShowsValuesTab}">
                            <DockPanel DataContext="{Binding Values}" x:DataType="values:HexValuesViewModel">
                                <!-- How wide the value read is - a selection's length, else the
                                     grouping's size - stepped a byte at a time, which selects that
                                     many bytes from where the reading starts; and where that is. -->
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="14,8,14,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Classes="orderreset"
                                                Click="OnNarrowValues"
                                                IsEnabled="{Binding CanNarrow}"
                                                ToolTip.Tip="Read one byte fewer">
                                            <icons:LucideIcon Data="{StaticResource Icon.Remove}" Size="11" />
                                        </Button>
                                        <TextBlock Text="{Binding SizeText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                        <Button Classes="orderreset"
                                                Click="OnWidenValues"
                                                IsEnabled="{Binding CanWiden}"
                                                ToolTip.Tip="Read one byte more, selecting it">
                                            <icons:LucideIcon Data="{StaticResource Icon.Add}" Size="11" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Text="{Binding OffsetText}"
                                               FontSize="12"
                                               FontFamily="{DynamicResource AppMonoFontFamily}"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="14,10,14,14" Spacing="12">
                                        <TextBlock Text="No bytes here."
                                                   IsVisible="{Binding !HasBytes}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />

                                        <!-- The bytes read, so each reading can be traced to them. -->
                                        <TextBlock Text="{Binding BytesText}"
                                                   IsVisible="{Binding HasBytes}"
                                                   FontSize="12"
                                                   FontFamily="{DynamicResource AppMonoFontFamily}" />

                                        <StackPanel IsVisible="{Binding HasBytes}" Spacing="0">
                                            <ItemsControl x:Name="ValueRows" ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="values:HexValueRow">
                                                        <!-- Hovering a reading marks its bytes in the dump;
                                                             clicking a value copies it. -->
                                                        <Border Classes="valuerow"
                                                                PointerEntered="OnValueRowEntered"
                                                                PointerExited="OnValueRowExited">
                                                            <Grid ColumnDefinitions="64,*">
                                                                <TextBlock Text="{Binding Name}" Classes="valuename" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Value}"
                                                                           Classes="value"
                                                                           Tapped="OnValueTapped" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- The same bytes as bits, grouped by byte, in file order. -->
                                        <StackPanel IsVisible="{Binding HasBytes}" Spacing="2">
                                            <TextBlock Text="Bits" Classes="valuehead" Margin="0,0,0,2" />
                                            <ItemsControl ItemsSource="{Binding BitsLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   FontFamily="{DynamicResource AppMonoFontFamily}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>

                        <!-- Structures: the definition pasted, how it was read, and what could not be. -->
                        <DockPanel IsVisible="{Binding ShowsStructuresTab}">
                            <DockPanel DataContext="{Binding Structs}" x:DataType="structs:StructDecoderViewModel" Margin="10,8,10,10">
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                    <ComboBox ItemsSource="{Binding LanguageNames}"
                                              SelectedIndex="{Binding SelectedLanguageIndex}"
                                              MinHeight="24"
                                              FontSize="12" />
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding LanguageText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                </Grid>
                                <ScrollViewer DockPanel.Dock="Bottom"
                                              MaxHeight="120"
                                              Margin="0,6,0,0"
                                              IsVisible="{Binding HasProblems}">
                                    <ItemsControl ItemsSource="{Binding Problems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <SelectableTextBlock Text="{Binding}"
                                                                     TextWrapping="Wrap"
                                                                     FontSize="11"
                                                                     Margin="0,1"
                                                                     Foreground="{DynamicResource AppMutedTextBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBox x:Name="DefinitionEditor"
                                         Text="{Binding DefinitionText}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         FontSize="12"
                                         FontFamily="{DynamicResource AppMonoFontFamily}"
                                         PlaceholderText="Paste a C, C++ or C# struct"
                                         PastingFromClipboard="OnDefinitionPasting" />
                            </DockPanel>
                        </DockPanel>

                        <!-- Struct: the bytes at the caret read as the struct picked. -->
                        <DockPanel IsVisible="{Binding ShowsStructTab}">
                            <DockPanel DataContext="{Binding Structs}" x:DataType="structs:StructDecoderViewModel">
                                <StackPanel DockPanel.Dock="Top" Margin="10,8,10,8" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasDefinition}">
                                        <ComboBox ItemsSource="{Binding Types}"
                                                  SelectedItem="{Binding SelectedType}"
                                                  HorizontalAlignment="Stretch"
                                                  MinHeight="24"
                                                  FontSize="12"
                                                  FontFamily="{DynamicResource AppMonoFontFamily}" />
                                        <ComboBox Grid.Column="1"
                                                  Margin="6,0,0,0"
                                                  ItemsSource="{Binding Targets}"
                                                  SelectedItem="{Binding Target}"
                                                  IsVisible="{Binding ShowsTarget}"
                                                  MinHeight="24"
                                                  FontSize="12"
                                                  ToolTip.Tip="What C leaves to the platform: the size of long, wchar_t and pointers, and how bitfields share storage">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="structs:StructTarget">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ToggleButton Grid.Column="2"
                                                      Classes="pin"
                                                      Margin="6,0,0,0"
                                                      IsChecked="{Binding IsPinned}"
                                                      ToolTip.Tip="Pin the struct where it is, so the caret can move inside it">
                                            <icons:LucideIcon Data="{StaticResource Icon.Pin}" Size="13" />
                                        </ToggleButton>
                                    </Grid>
                                    <TextBlock Text="{Binding Message}"
                                               IsVisible="{Binding HasMessage}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                </StackPanel>

                                <!-- The tree's title, as the dump's header: the struct, and its size,
                                     alignment and place. -->
                                <Border DockPanel.Dock="Top"
                                        Height="24"
                                        Padding="10,0"
                                        IsVisible="{Binding HasStruct}"
                                        Background="{DynamicResource AppChipBrush}"
                                        BorderBrush="{DynamicResource AppSubtleIconBrush}"
                                        BorderThickness="0,1,0,1">
                                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StructTitle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                                   Foreground="{DynamicResource AppTextBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding StructDetail}"
                                                   FontSize="11"
                                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>

                                <DockPanel>
                                    <ScrollBar x:Name="StructPanScrollBar"
                                               DockPanel.Dock="Bottom"
                                               Orientation="Horizontal"
                                               AllowAutoHide="False"
                                               IsVisible="False"
                                               Minimum="0" />
                                    <ScrollBar x:Name="StructVerticalScrollBar"
                                               DockPanel.Dock="Right"
                                               Orientation="Vertical"
                                               IsVisible="False"
                                               Minimum="0" />
                                    <tree:TreeSurface x:Name="StructSurface"
                                                      Background="{DynamicResource AppPanelBackgroundBrush}"
                                                      FontFamily="{DynamicResource AppMonoFontFamily}"
                                                      FontSize="12"
                                                      Foreground="{DynamicResource AppTextBrush}"
                                                      GutterForeground="{DynamicResource AppSubtleIconBrush}"
                                                      SelectionBrush="{DynamicResource AppAccentSurfaceBrush}"
                                                      ChipFontFamily="{DynamicResource AppSansFontFamily}"
                                                      ChipBackground="{DynamicResource AppChipBrush}"
                                                      ChipHoverBackground="{DynamicResource AppChipHoverBrush}"
                                                      ExpanderBrush="{DynamicResource AppSubtleIconBrush}"
                                                      ExpanderRowHoverBrush="{DynamicResource AppMutedTextBrush}"
                                                      GuideBrush="{DynamicResource AppIndentGuideBrush}" />
                                </DockPanel>
                            </DockPanel>
                        </DockPanel>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- Status gutter, as the raw view's: the character the caret is in on the left, and
                 where the caret is and how much is selected on the right, each in one place.
                 What the bytes read as is the side panel's job. -->
            <Border Grid.Row="2"
                    Grid.ColumnSpan="3"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    Padding="8,4"
                    MinHeight="24">
                <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="CaretCharacterText"
                           Text="{Binding CaretCharacterText}"
                           FontSize="11"
                           FontFamily="{DynamicResource AppContentFontFamily}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Width="1"
                        Margin="12,1"
                        Background="{DynamicResource AppBorderBrush}" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CaretSelectionText"
                               Text="{Binding CaretSelectionText}"
                               FontSize="11"
                               FontFamily="{DynamicResource AppContentFontFamily}"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               VerticalAlignment="Center" />
                    <!-- Where the caret is, and where to go: clicking it, or Ctrl/Cmd+L, swaps it
                         for an entry holding the caret's offset. -->
                    <Panel VerticalAlignment="Center">
                        <Button x:Name="CaretPositionButton"
                                Classes="position"
                                Click="OnCaretPositionClick"
                                ToolTip.Tip="Go to offset (Ctrl+L / Cmd+L)">
                            <TextBlock x:Name="CaretPositionText"
                                       Text="{Binding CaretPositionText}"
                                       FontSize="11"
                                       FontFamily="{DynamicResource AppContentFontFamily}" />
                        </Button>
                        <TextBox x:Name="GoToEntry"
                                 IsVisible="False"
                                 Width="170"
                                 MinHeight="20"
                                 Height="20"
                                 Padding="6,1"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 FontFamily="{DynamicResource AppContentFontFamily}"
                                 PlaceholderText="Offset: 8000 or 0x1F40"
                                 KeyDown="OnGoToEntryKeyDown"
                                 LostFocus="OnGoToEntryLostFocus" />
                    </Panel>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
