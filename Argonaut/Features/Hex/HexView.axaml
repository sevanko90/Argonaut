<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hex="clr-namespace:Argonaut.Features.Hex"
             x:Class="Argonaut.Features.Hex.HexView"
             x:DataType="hex:HexViewModel">
    <UserControl.Styles>
        <!-- The caret's position reads as status text, and shows it can be clicked on hover. -->
        <Style Selector="Button.position">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="Button.position:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource AppWindowBackgroundBrush}" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto,Auto" ColumnDefinitions="*,Auto">
            <!-- Draws the rows on screen itself; RowScrollBars drives the two bars, as for every
                 self-drawn view. -->
            <hex:HexSurface x:Name="Surface"
                            Background="{DynamicResource AppWindowBackgroundBrush}"
                            FontFamily="{DynamicResource AppMonoFontFamily}"
                            FontSize="{DynamicResource AppContentFontSize}"
                            Foreground="{DynamicResource AppTextBrush}"
                            GutterForeground="{DynamicResource AppMutedTextBrush}"
                            OtherByteForeground="{DynamicResource AppJsonNumberBrush}"
                            ZeroByteForeground="{DynamicResource AppSubtleIconBrush}"
                            HeaderLineBrush="{DynamicResource AppSubtleIconBrush}"
                            PanelBackground="{DynamicResource AppChipBrush}"
                            DividerBrush="{DynamicResource AppBorderBrush}"
                            ByteMarkBrush="{DynamicResource AppAccentBrush}"
                            ByteMarkForeground="{DynamicResource AppWindowBackgroundBrush}"
                            RowMarkBrush="{DynamicResource AppHoverBackgroundBrush}"
                            SelectionBrush="{DynamicResource AppTextSelectionBrush}" />

            <ScrollBar x:Name="VerticalScrollBar"
                       Grid.Column="1"
                       Orientation="Vertical"
                       IsVisible="False"
                       Minimum="0" />

            <ScrollBar x:Name="PanScrollBar"
                       Grid.Row="1"
                       Orientation="Horizontal"
                       AllowAutoHide="False"
                       IsVisible="False"
                       Minimum="0" />

            <!-- Status gutter, as the raw view's: where the caret is, and how much is selected,
                 in one place at the right. What the byte reads as is the side panel's job. -->
            <Border Grid.Row="2"
                    Grid.ColumnSpan="2"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    Padding="8,4"
                    MinHeight="24">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CaretSelectionText"
                               Text="{Binding CaretSelectionText}"
                               FontSize="11"
                               FontFamily="{DynamicResource AppContentFontFamily}"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               VerticalAlignment="Center" />
                    <!-- Where the caret is, and where to go: clicking it, or Ctrl/Cmd+L, swaps it
                         for an entry holding the caret's offset. -->
                    <Panel VerticalAlignment="Center">
                        <Button x:Name="CaretPositionButton"
                                Classes="position"
                                Click="OnCaretPositionClick"
                                ToolTip.Tip="Go to offset (Ctrl+L / Cmd+L)">
                            <TextBlock x:Name="CaretPositionText"
                                       Text="{Binding CaretPositionText}"
                                       FontSize="11"
                                       FontFamily="{DynamicResource AppContentFontFamily}" />
                        </Button>
                        <TextBox x:Name="GoToEntry"
                                 IsVisible="False"
                                 Width="170"
                                 MinHeight="20"
                                 Height="20"
                                 Padding="6,1"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 FontFamily="{DynamicResource AppContentFontFamily}"
                                 PlaceholderText="Offset: 8000 or 0x1F40"
                                 KeyDown="OnGoToEntryKeyDown"
                                 LostFocus="OnGoToEntryLostFocus" />
                    </Panel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
