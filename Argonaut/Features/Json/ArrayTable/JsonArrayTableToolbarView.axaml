<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arrayTable="clr-namespace:Argonaut.Features.Json.ArrayTable"
             xmlns:icons="clr-namespace:Argonaut.Ui.Icons"
             x:Class="Argonaut.Features.Json.ArrayTable.JsonArrayTableToolbarView"
             x:DataType="arrayTable:JsonArrayTableToolbarViewModel">
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <!-- Identify the array; the window title already identifies the file. -->
        <TextBlock Text="{Binding OriginDescription}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="320"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   FontSize="12"
                   ToolTip.Tip="{Binding OriginDescription}" />

        <Button Click="OnBack"
                Classes="tool icononly"
                ToolTip.Tip="Back to JSON: reopen the file as JSON and select this array">
            <icons:LucideIcon Data="{StaticResource Icon.Back}" />
        </Button>

        <!-- Hidden for an array of objects: its columns are the property names by definition,
             so there is nothing to re-width into.

             A plain ComboBox, deliberately not a flyout that closes on pick: the selection
             setter runs inside Avalonia's still-open selection commit, and the collection Reset
             it causes is safe only because that Reset lands on the grid, never on this picker's
             own ItemsSource (see the view model's remarks and CLAUDE.md). -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding CanReshape}">
            <TextBlock Text="Columns"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       FontSize="12" />
            <ComboBox ItemsSource="{Binding ColumnModes}"
                      SelectedItem="{Binding SelectedColumnMode}"
                      Classes="tool"
                      ToolTip.Tip="One row per element by property name, or reshape a flat array into N columns">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="arrayTable:JsonArrayColumnModeOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Only shown once a column is known to hold an array - which can become true after an
             expansion reveals one, so the document answers it after every discovery rather than
             once at load. Same plain-ComboBox reasoning as the mode picker above. -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding CanExpandArrays}">
            <TextBlock Text="Array columns"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       FontSize="12" />
            <ComboBox ItemsSource="{Binding ArrayColumnCounts}"
                      SelectedItem="{Binding SelectedArrayColumns}"
                      Classes="tool"
                      ToolTip.Tip="How many positions an expanded array column draws before the rest are summarised in one" />
        </StackPanel>

        <!-- For the selected cell's tree. -->
        <ToggleButton IsChecked="{Binding ShowIndentGuides, Mode=TwoWay}"
                      Classes="tool icononly"
                      ToolTip.Tip="Indent guides: a line down each open container's contents">
            <icons:LucideIcon Data="{StaticResource Icon.IndentGuides}" />
        </ToggleButton>
    </StackPanel>
</UserControl>
