<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:json="clr-namespace:Argonaut.Features.Json"
             xmlns:arrayTable="clr-namespace:Argonaut.Features.Json.ArrayTable"
             xmlns:grid="clr-namespace:Argonaut.Ui.TableGrid"
             xmlns:preview="clr-namespace:Argonaut.Features.Json.Preview"
             x:Class="Argonaut.Features.Json.ArrayTable.JsonArrayTableView"
             x:DataType="arrayTable:JsonArrayTableViewModel">

    <!-- The grid draws itself (TableSurface), as the CSV view's does: the column headers pinned
         across the top and only the cells on screen. Columns are data, not markup - the view
         model's TableStructure and route headers, which a re-shape replaces - so the code-behind
         hands them over rather than binding them. No gutter: an element's row number is not a
         line of the file, and the cell pane's title already says which row a value is from.

         The find highlight is absent here on purpose - the table returns no search navigator in
         v1, so there is never a term to highlight. -->
    <Grid x:Name="Layout" ColumnDefinitions="*,Auto,Auto">
        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0"
                Background="{DynamicResource AppWindowBackgroundBrush}"
                ClipToBounds="True">
            <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
                <grid:TableSurface x:Name="Surface"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Background="{DynamicResource AppWindowBackgroundBrush}"
                                   HeaderBackground="{DynamicResource AppPanelBackgroundBrush}"
                                   RowBandBrush="{DynamicResource AppPanelBackgroundBrush}"
                                   GridLineBrush="{DynamicResource AppBorderBrush}"
                                   FontFamily="{DynamicResource AppContentFontFamily}"
                                   FontSize="{DynamicResource AppContentFontSize}"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   GutterForeground="{DynamicResource AppMutedTextBrush}"
                                   SelectionBrush="{DynamicResource AppTextSelectionBrush}"
                                   HoverBrush="{DynamicResource AppHoverBackgroundBrush}"
                                   LinkForeground="{DynamicResource AppAccentBrush}" />

                <ScrollBar x:Name="VerticalScrollBar"
                           Grid.Row="0"
                           Grid.Column="1"
                           Orientation="Vertical"
                           IsVisible="False"
                           Minimum="0" />

                <ScrollBar x:Name="PanScrollBar"
                           Grid.Row="1"
                           Grid.Column="0"
                           Orientation="Horizontal"
                           AllowAutoHide="False"
                           IsVisible="False"
                           Minimum="0" />
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      IsVisible="{Binding HasCellDetail}" />

        <!-- One CELL in full, beside the grid rather than instead of it: a long scalar the column
             could never show, or a container's own tree. Scoped to the cell rather than the row -
             a row's tree here would just be the JSON view with the element collapsed, which is
             where the reader came from. The column's width is driven from code-behind, so that
             dragging the splitter sizes the pane the user keeps. -->
        <Border Grid.Column="2"
                x:Name="Detail"
                IsVisible="{Binding HasCellDetail}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1,0,0,0"
                Background="{DynamicResource AppWindowBackgroundBrush}"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*,Auto" Margin="8">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                    <TextBlock Text="{Binding CellDetail.Title}"
                               ToolTip.Tip="{Binding CellDetail.Title}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="12" />
                    <Button Grid.Column="1"
                            Content="Copy"
                            Click="OnCopyDetailText"
                            IsVisible="{Binding CellDetail.IsText}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,0"
                            FontSize="12"
                            ToolTip.Tip="Copy the value as it is in the cell" />
                    <Button Grid.Column="2"
                            Content="✕"
                            Click="OnCloseDetail"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,0"
                            ToolTip.Tip="Close the cell pane" />
                </Grid>

                <!-- The cell in full - its text, or its own tree over just this cell's bytes, so
                     a 2,199-item array opens instantly. Its own scroll: reading a value must never
                     move the grid the reader is comparing rows in. -->
                <preview:ValuePreviewView Grid.Row="1"
                                          Grid.RowSpan="2"
                                          DataContext="{Binding CellDetail}"
                                          ShowIndentGuides="{Binding $parent[arrayTable:JsonArrayTableView].((arrayTable:JsonArrayTableViewModel)DataContext).ShowIndentGuides, FallbackValue=False}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
