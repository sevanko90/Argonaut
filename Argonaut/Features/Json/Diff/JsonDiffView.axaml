<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:json="clr-namespace:Argonaut.Features.Json"
             xmlns:diff="clr-namespace:Argonaut.Features.Json.Diff"
             xmlns:tree="clr-namespace:Argonaut.Ui.Tree"
             x:Class="Argonaut.Features.Json.Diff.JsonDiffView"
             x:DataType="diff:JsonDiffViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Features/Json/JsonRowStyles.axaml" />
    </UserControl.Styles>

    <Border BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource AppWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
        <!-- One surface, both documents: each row is drawn two panes wide by JsonDiffPainter, so
             the sides stay aligned row for row and scroll as one. The panes clip rather than pan
             (both must stay visible); the context bar carries a long value's detail. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <tree:TreeSurface x:Name="Surface"
                              Grid.Column="0"
                              Background="{DynamicResource AppWindowBackgroundBrush}"
                              FontFamily="{DynamicResource AppContentFontFamily}"
                              FontSize="{DynamicResource AppContentFontSize}"
                              Foreground="{DynamicResource AppTextBrush}"
                              GutterForeground="{DynamicResource AppMutedTextBrush}"
                              DividerBrush="{DynamicResource AppBorderBrush}"
                              HighlightBrush="{DynamicResource AppSearchHighlightBrush}"
                              SelectionBrush="{DynamicResource AppAccentSurfaceBrush}" />

            <ScrollBar x:Name="VerticalScrollBar"
                       Grid.Column="1"
                       Orientation="Vertical"
                       IsVisible="False"
                       Minimum="0" />
        </Grid>

        <!-- Context bar: two fixed lines showing the selected row's source (left document)
             and target (right document) side - the value by default, its JSONPath via the
             per-line swap link. Values never wrap (they trim with an ellipsis), and the
             Run split paints exactly the characters that differ between the two sides. -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                Padding="8,4">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="No selection"
                           FontSize="11"
                           IsVisible="{Binding !HasSelection}"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           FontFamily="{DynamicResource AppContentFontFamily}" />

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="source"
                           Width="44"
                           FontSize="11"
                           IsVisible="{Binding HasSelection}"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="1"
                        Classes="hintlink"
                        FontSize="11"
                        Content="{Binding SourceModeLabel}"
                        IsVisible="{Binding HasSelection}"
                        Click="OnToggleSourceMode"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Swap between the selected value and its JSONPath" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           FontSize="11"
                           IsVisible="{Binding ShowSourceValue}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource AppContentFontFamily}"><Run Text="{Binding SourcePrefix}" /><Run Text="{Binding SourceChanged}" Background="#59FFC107" /><Run Text="{Binding SourceSuffix}" /></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding SourcePlaceholder}"
                           FontSize="11"
                           FontStyle="Italic"
                           IsVisible="{Binding SourcePlaceholder, Converter={x:Static json:IsNotNullConverter.Instance}}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMutedTextBrush}" />
                <Button Grid.Row="0" Grid.Column="3"
                        x:Name="CopySourceButton"
                        Classes="iconbutton compact"
                        Click="OnCopySourceClick"
                        IsVisible="{Binding HasSelection}"
                        IsEnabled="{Binding ShowSourceValue}"
                        ToolTip.Tip="Copy"
                        Margin="8,0,0,0">
                    <Viewbox Width="12" Height="12">
                        <Path Fill="{DynamicResource AppMutedTextBrush}"
                              Data="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z" />
                    </Viewbox>
                </Button>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="target"
                           Width="44"
                           FontSize="11"
                           IsVisible="{Binding HasSelection}"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="1"
                        Classes="hintlink"
                        FontSize="11"
                        Content="{Binding TargetModeLabel}"
                        IsVisible="{Binding HasSelection}"
                        Click="OnToggleTargetMode"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Swap between the selected value and its JSONPath" />
                <TextBlock Grid.Row="1" Grid.Column="2"
                           FontSize="11"
                           IsVisible="{Binding ShowTargetValue}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource AppContentFontFamily}"><Run Text="{Binding TargetPrefix}" /><Run Text="{Binding TargetChanged}" Background="#59FFC107" /><Run Text="{Binding TargetSuffix}" /></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="{Binding TargetPlaceholder}"
                           FontSize="11"
                           FontStyle="Italic"
                           IsVisible="{Binding TargetPlaceholder, Converter={x:Static json:IsNotNullConverter.Instance}}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMutedTextBrush}" />
                <Button Grid.Row="1" Grid.Column="3"
                        x:Name="CopyTargetButton"
                        Classes="iconbutton compact"
                        Click="OnCopyTargetClick"
                        IsVisible="{Binding HasSelection}"
                        IsEnabled="{Binding ShowTargetValue}"
                        ToolTip.Tip="Copy"
                        Margin="8,0,0,0">
                    <Viewbox Width="12" Height="12">
                        <Path Fill="{DynamicResource AppMutedTextBrush}"
                              Data="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
        </Grid>
    </Border>
</UserControl>
