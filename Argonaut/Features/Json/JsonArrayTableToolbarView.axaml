<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:json="clr-namespace:Argonaut.Features.Json"
             x:Class="Argonaut.Features.Json.JsonArrayTableToolbarView"
             x:DataType="json:JsonArrayTableToolbarViewModel">
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <!-- Provenance: this document has no path of its own, so the banner is the only thing
             saying which array of which file is on screen. -->
        <TextBlock Text="{Binding OriginDescription}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="420"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   FontSize="12"
                   ToolTip.Tip="{Binding OriginDescription}" />

        <Button Content="Back to JSON"
                Click="OnBack"
                VerticalAlignment="Center"
                ToolTip.Tip="Reopen the file as JSON and select this array" />

        <!-- A plain ComboBox, deliberately not a flyout that closes on pick: the selection
             setter runs inside Avalonia's still-open selection commit, and the collection Reset
             it causes is safe only because that Reset lands on the grid, never on this picker's
             own ItemsSource (see the view model's remarks and CLAUDE.md). -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Columns"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       FontSize="12" />
            <ComboBox ItemsSource="{Binding ColumnModes}"
                      SelectedItem="{Binding SelectedColumnMode}"
                      MinWidth="130"
                      VerticalAlignment="Center"
                      ToolTip.Tip="One row per element by property name, or reshape a flat array into N columns">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="json:JsonArrayColumnModeOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
    </StackPanel>
</UserControl>
