<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:json="clr-namespace:Argonaut.Features.Json"
             xmlns:search="clr-namespace:Argonaut.Features.Search"
             x:Class="Argonaut.Features.Json.JsonRowPresenter"
             x:DataType="json:JsonRow">
    <!-- The read-only content of one JSON row (name, value, truncation note), shared by the
         diff view's two panes (diff plan stage 0.3). Interaction wiring - expanders, hint
         and truncation-jump buttons - stays with the hosting view; the JSON view keeps its
         richer inline template for exactly that reason. Renders nothing when no row is bound
         (an absent diff side).

         Search highlighting IS here, driven by the HighlightTerm property the host sets
         (find spans both diff panes, so both need it and neither owns it).

         A Grid (not a horizontal StackPanel): a StackPanel measures children at infinite
         width, so a long value would report its full width upward and push the diff's right
         pane off screen. The star column bounds the value to whatever the host actually
         has, and the value trims with an ellipsis there - detail lives in the context bar. -->
    <Grid ColumnDefinitions="Auto,*"
          IsVisible="{Binding Converter={x:Static json:IsNotNullConverter.Instance}}">
        <TextBlock Grid.Column="0"
                   search:SearchHighlight.Text="{Binding Name}"
                   search:SearchHighlight.Suffix=": "
                   search:SearchHighlight.Term="{Binding $parent[json:JsonRowPresenter].HighlightTerm}"
                   IsVisible="{Binding Name, Converter={x:Static json:IsNotNullConverter.Instance}}"
                   Foreground="{DynamicResource AppAccentBrush}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="280"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource AppContentFontFamily}" />
        <TextBlock Grid.Column="1"
                   search:SearchHighlight.Text="{Binding Value}"
                   search:SearchHighlight.Term="{Binding $parent[json:JsonRowPresenter].HighlightTerm}"
                   Classes="rowValue"
                   Classes.jsonString="{Binding IsStringValue}"
                   Classes.jsonNumber="{Binding IsNumberValue}"
                   Classes.jsonBool="{Binding IsBooleanValue}"
                   Classes.jsonNull="{Binding IsNullValue}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource AppContentFontFamily}" />
    </Grid>
</UserControl>
