<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Row-content styles shared by JsonView and JsonDiffView (diff plan stage 0.3):
         per-type value colouring, the link-styled buttons, and the schema gutter's
         container-heading weight. Moved verbatim out of JsonView.axaml. -->

    <Style Selector="TextBlock.jsonString">
        <Setter Property="Foreground" Value="{DynamicResource AppJsonStringBrush}" />
    </Style>
    <Style Selector="TextBlock.jsonNumber">
        <Setter Property="Foreground" Value="{DynamicResource AppJsonNumberBrush}" />
    </Style>
    <Style Selector="TextBlock.jsonBool">
        <Setter Property="Foreground" Value="{DynamicResource AppJsonBoolBrush}" />
    </Style>
    <Style Selector="TextBlock.jsonNull">
        <Setter Property="Foreground" Value="{DynamicResource AppJsonNullBrush}" />
    </Style>

    <Style Selector="Button.pathlink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.pathlink:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentHoverBrush}" />
    </Style>

    <Style Selector="Button.hintlink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppContentFontFamily}" />
    </Style>
    <Style Selector="Button.hintlink:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Schema gutter: a container's label heads the run of child labels indented beneath it.
         Weight only - every container is a heading, so a deep document would otherwise stack
         several emphasised rows in a row, and nesting is already carried by the indent. -->
    <Style Selector="TextBlock.schemaContainer">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</Styles>
