<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:json="clr-namespace:Argonaut.Features.Json"
             xmlns:schema="clr-namespace:Argonaut.Features.Json.Schema"
             xmlns:icons="clr-namespace:Argonaut.Ui.Icons"
             xmlns:conv="clr-namespace:Argonaut.Ui.Converters"
             mc:Ignorable="d"
             x:Class="Argonaut.Features.Json.JsonToolbarView"
             x:DataType="json:JsonToolbarViewModel">
    <!-- One row of title-bar controls. Go-to-path is not here: it lives in the path bar at the
         foot of the tree, where the path it navigates is shown. -->
    <StackPanel Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center">
        <Button x:Name="DateButton"
                Classes="tool"
                ToolTip.Tip="Hints: date interpretation and time format">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:LucideIcon Data="{StaticResource Icon.Hints}" />
                <icons:LucideIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Margin="12" Spacing="12" MinWidth="170">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="flyouthead" Text="Date interpretation" />
                            <RadioButton GroupName="dateHintScheme"
                                         Content="Off"
                                         FontSize="12"
                                         IsChecked="{Binding DateHintSchemeIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                            <RadioButton GroupName="dateHintScheme"
                                         Content="JS milliseconds"
                                         FontSize="12"
                                         IsChecked="{Binding DateHintSchemeIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                            <RadioButton GroupName="dateHintScheme"
                                         Content="JS seconds"
                                         FontSize="12"
                                         IsChecked="{Binding DateHintSchemeIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=2}" />
                            <RadioButton GroupName="dateHintScheme"
                                         Content="Keepa minutes"
                                         FontSize="12"
                                         IsChecked="{Binding DateHintSchemeIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=3}" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" />
                        <StackPanel Spacing="2">
                            <TextBlock Classes="flyouthead" Text="Time format" />
                            <RadioButton GroupName="dateHintTimeZone"
                                         Content="Local time"
                                         FontSize="12"
                                         IsChecked="{Binding TimeZoneModeIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                            <RadioButton GroupName="dateHintTimeZone"
                                         Content="UTC"
                                         FontSize="12"
                                         IsChecked="{Binding TimeZoneModeIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                        </StackPanel>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
        <!-- One control, not two: the schema file and the type within it are a single question,
             and a flyout is the only surface that can host a filter box AND descriptions AND a
             match-ranked shortlist - which a combo or a menu cannot. Merging them also halves
             what this block costs on a toolbar that already wraps. -->
        <Button x:Name="SchemaButton"
                Classes="tool"
                ToolTip.Tip="JSON Schema used to label values in the tree, and which type in it describes this document">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:LucideIcon Data="{StaticResource Icon.Schema}" />
                <TextBlock Text="{Binding SchemaButtonText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220" />
                <icons:LucideIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft"
                        IsOpen="{Binding IsSchemaFlyoutOpen, Mode=TwoWay}">
                    <StackPanel Margin="8" Spacing="8" Width="360">
                        <TextBlock Text="Schema"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="2,0,0,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                        <ListBox x:Name="SchemaList"
                                 ItemsSource="{Binding SchemaItems}"
                                 SelectedIndex="{Binding SelectedSchemaIndex, Mode=TwoWay}"
                                 MaxHeight="200"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                        <!-- Only for a schema holding several types; a single-schema file has
                             nothing to choose and shows the schema list alone. -->
                        <Border Height="1"
                                Background="{DynamicResource AppBorderBrush}"
                                IsVisible="{Binding SchemaRootPicker.IsApplicable}" />
                        <TextBlock Text="Type"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="2,0,0,0"
                                   IsVisible="{Binding SchemaRootPicker.IsApplicable}"
                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                        <TextBox Text="{Binding SchemaRootPicker.Filter, Mode=TwoWay}"
                                 PlaceholderText="Filter types…"
                                 IsVisible="{Binding SchemaRootPicker.IsApplicable}"
                                 FontSize="12" />
                        <TextBlock Text="{Binding SchemaRootPicker.MatchContextText}"
                                   IsVisible="{Binding SchemaRootPicker.HasMatchContext}"
                                   FontSize="11"
                                   Margin="2,0,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                        <ListBox ItemsSource="{Binding SchemaRootPicker.Picks}"
                                 SelectedItem="{Binding SchemaRootPicker.SelectedPick, Mode=TwoWay}"
                                 IsVisible="{Binding SchemaRootPicker.IsApplicable}"
                                 MaxHeight="300"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.Styles>
                                <!-- Headers ride in the same list so it stays one scrollable,
                                     filterable surface; this is what stops them being picked. -->
                                <Style Selector="ListBoxItem" x:DataType="schema:SchemaRootPick">
                                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="schema:SchemaRootPick">
                                  <StackPanel>
                                    <Border Height="1"
                                            Margin="0,6,0,8"
                                            IsVisible="{Binding ShowSeparator}"
                                            Background="{DynamicResource AppBorderBrush}" />
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   Text="{Binding Name}"
                                                   IsVisible="{Binding IsSelectable}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding Name}"
                                                   IsVisible="{Binding IsHeader}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                        <StackPanel Grid.Column="1"
                                                    Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Border IsVisible="{Binding IsRecommended}"
                                                    CornerRadius="3"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemAccentColorLight2}">
                                                <TextBlock Text="best match"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="Black" />
                                            </Border>
                                            <TextBlock Text="{Binding Score}"
                                                       IsVisible="{Binding HasScore}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding Description}"
                                                   IsVisible="{Binding Description, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                    </Grid>
                                  </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
        <!-- The value is the depth itself; 0 is "start collapsed". -->
        <Button x:Name="ExpandDepthButton"
                Classes="tool"
                ToolTip.Tip="Auto-expand: how many levels open when a file opens">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:LucideIcon Data="{StaticResource Icon.ExpandDepth}" />
                <TextBlock Classes="toolvalue" Text="{Binding ExpandDepthIndex}" />
                <icons:LucideIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Margin="12" Spacing="2" MinWidth="150">
                        <TextBlock Classes="flyouthead" Text="Auto-expand on open" />
                        <RadioButton GroupName="expandDepth"
                                     Content="Start collapsed"
                                     FontSize="12"
                                     IsChecked="{Binding ExpandDepthIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                        <RadioButton GroupName="expandDepth"
                                     Content="1 level"
                                     FontSize="12"
                                     IsChecked="{Binding ExpandDepthIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                        <RadioButton GroupName="expandDepth"
                                     Content="2 levels"
                                     FontSize="12"
                                     IsChecked="{Binding ExpandDepthIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=2}" />
                        <RadioButton GroupName="expandDepth"
                                     Content="3 levels"
                                     FontSize="12"
                                     IsChecked="{Binding ExpandDepthIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=3}" />
                        <RadioButton GroupName="expandDepth"
                                     Content="4 levels"
                                     FontSize="12"
                                     IsChecked="{Binding ExpandDepthIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=4}" />
                        <RadioButton GroupName="expandDepth"
                                     Content="5 levels"
                                     FontSize="12"
                                     IsChecked="{Binding ExpandDepthIndex, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=5}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
