<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:json="clr-namespace:Argonaut.Features.Json"
             xmlns:jsontree="clr-namespace:Argonaut.Features.Json.Tree"
             xmlns:tree="clr-namespace:Argonaut.Ui.Tree"
             x:Class="Argonaut.Features.Json.JsonView"
             x:DataType="json:JsonViewModel">
    <UserControl.Styles>
        <!-- Row-content styles shared with JsonDiffView - see JsonRowStyles.axaml. -->
        <StyleInclude Source="/Features/Json/JsonRowStyles.axaml" />
    </UserControl.Styles>

    <!-- Edge to edge: the tree is the window's content, not a card inside it. -->
    <Border Background="{DynamicResource AppWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
            <!-- The surface draws every visible row itself, schema gutter included. The two
                 scrollbars drive it through RowScrollBars, as every self-drawn view's do: the
                 vertical one over its position in the document, the pan one over TreeSurface.PanOffset,
                 which moves the rows and leaves the gutter pinned. -->
            <Grid Grid.Row="0" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
                <tree:TreeSurface x:Name="Surface"
                                  Grid.Row="0"
                                  Grid.Column="0"
                                  Background="{DynamicResource AppWindowBackgroundBrush}"
                                  FontFamily="{DynamicResource AppContentFontFamily}"
                                  FontSize="{DynamicResource AppContentFontSize}"
                                  Foreground="{DynamicResource AppTextBrush}"
                                  GutterForeground="{DynamicResource AppMutedTextBrush}"
                                  GutterBackground="{DynamicResource AppPanelBackgroundBrush}"
                                  DividerBrush="{DynamicResource AppBorderBrush}"
                                  HighlightBrush="{DynamicResource AppSearchHighlightBrush}"
                                  SelectionBrush="{DynamicResource AppAccentSurfaceBrush}" />

                <ScrollBar x:Name="VerticalScrollBar"
                           Grid.Row="0"
                           Grid.Column="1"
                           Orientation="Vertical"
                           IsVisible="False"
                           Minimum="0" />

                <ScrollBar x:Name="PanScrollBar"
                           Grid.Row="1"
                           Grid.Column="0"
                           Orientation="Horizontal"
                           AllowAutoHide="False"
                           IsVisible="False"
                           Minimum="0" />
            </Grid>

            <!-- The path bar: where the selection is, and where to go. Clicking its empty space,
                 the go-to button or Ctrl/Cmd+L turns it into an entry for a JSONPath, prefilled
                 with the selection's, so jumping somewhere near is an edit rather than a retype. -->
            <Border Grid.Row="1"
                    x:Name="PathBar"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    Height="30"
                    Padding="10,0,6,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Viewbox Grid.Column="0" Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center">
                        <!-- Material "data_object" -->
                        <Path Fill="{DynamicResource AppSubtleIconBrush}"
                              Data="M4 7v2c0 .55-.45 1-1 1H2v4h1c.55 0 1 .45 1 1v2c0 1.65 1.35 3 3 3h3v-2H7c-.55 0-1-.45-1-1v-2c0-1.3-.84-2.42-2-2.83v-.34C5.16 11.42 6 10.3 6 9V7c0-.55.45-1 1-1h3V4H7C5.35 4 4 5.35 4 7zM21 10c-.55 0-1-.45-1-1V7c0-1.65-1.35-3-3-3h-3v2h3c.55 0 1 .45 1 1v2c0 1.3.84 2.42 2 2.83v.34c-1.16.41-2 1.52-2 2.83v2c0 .55-.45 1-1 1h-3v2h3c1.65 0 3-1.35 3-3v-2c0-.55.45-1 1-1h1v-4h-1z" />
                    </Viewbox>

                    <!-- Hit-testable background, so a click anywhere along the bar opens the entry. -->
                    <Border Grid.Column="1"
                            x:Name="PathDisplay"
                            Background="Transparent"
                            Cursor="IBeam"
                            PointerPressed="OnPathBarPressed">
                        <Panel VerticalAlignment="Center">
                            <TextBlock Text="No selection — click to go to a path"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedPath, Converter={x:Static json:IsNullConverter.Instance}}"
                                       Foreground="{DynamicResource AppSubtleIconBrush}" />
                            <ItemsControl ItemsSource="{Binding SelectedPathSegments}"
                                          IsVisible="{Binding SelectedPath, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="jsontree:JsonTreePathSegment">
                                        <Button Content="{Binding Label}"
                                                Click="OnPathSegmentClick"
                                                Classes="pathlink"
                                                FontSize="11"
                                                FontFamily="{DynamicResource AppContentFontFamily}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </Border>

                    <TextBox Grid.Column="1"
                             x:Name="PathEntry"
                             IsVisible="False"
                             MinHeight="22"
                             Height="22"
                             Padding="6,2"
                             FontSize="11"
                             VerticalAlignment="Center"
                             FontFamily="{DynamicResource AppContentFontFamily}"
                             PlaceholderText="$.path.to[0]"
                             KeyDown="OnPathEntryKeyDown"
                             LostFocus="OnPathEntryLostFocus" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                        <Button x:Name="GoToPathButton"
                                Classes="iconbutton compact"
                                Click="OnGoToPathClick"
                                ToolTip.Tip="Go to a JSONPath (Ctrl+L / Cmd+L)">
                            <Viewbox Width="12" Height="12">
                                <!-- Material "arrow_forward" -->
                                <Path Fill="{DynamicResource AppMutedTextBrush}"
                                      Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="CopyValueButton"
                                Classes="iconbutton compact"
                                Click="OnCopyValueClick"
                                IsEnabled="{Binding SelectedPath, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                ToolTip.Tip="Copy value">
                            <Viewbox Width="12" Height="12">
                                <Path Fill="{DynamicResource AppMutedTextBrush}"
                                      Data="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="CopyPathButton"
                                Classes="iconbutton compact"
                                Click="OnCopyPathClick"
                                IsEnabled="{Binding SelectedPath, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                ToolTip.Tip="Copy JSONPath">
                            <Viewbox Width="12" Height="12">
                                <Path Fill="{DynamicResource AppMutedTextBrush}"
                                      Data="M18 2H9a2 2 0 0 0-2 2v2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-2h2a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM14 20H5V8h9v12zm4-4h-2V8a2 2 0 0 0-2-2H9V4h9v12z" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
