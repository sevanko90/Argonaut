<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:json="clr-namespace:Argonaut.Features.Json"
             xmlns:search="clr-namespace:Argonaut.Features.Search"
             x:Class="Argonaut.Features.Json.JsonView"
             x:DataType="json:JsonViewModel">
    <UserControl.Resources>
        <json:DepthToMarginConverter x:Key="DepthToMargin" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.jsonString">
            <Setter Property="Foreground" Value="{DynamicResource AppJsonStringBrush}" />
        </Style>
        <Style Selector="TextBlock.jsonNumber">
            <Setter Property="Foreground" Value="{DynamicResource AppJsonNumberBrush}" />
        </Style>
        <Style Selector="TextBlock.jsonBool">
            <Setter Property="Foreground" Value="{DynamicResource AppJsonBoolBrush}" />
        </Style>
        <Style Selector="TextBlock.jsonNull">
            <Setter Property="Foreground" Value="{DynamicResource AppJsonNullBrush}" />
        </Style>

        <Style Selector="Button.pathlink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button.pathlink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentHoverBrush}" />
        </Style>

        <Style Selector="Button.hintlink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppContentFontFamily}" />
        </Style>
        <Style Selector="Button.hintlink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource AppWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
            <ListBox Grid.Row="0"
                     x:Name="RowsListBox"
                     ItemsSource="{Binding Rows}"
                     SelectionMode="Single"
                     Padding="8,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.Styles>
                    <!-- Rounded, inset highlight instead of Fluent's flat full-bleed selection
                         rectangle - matches the rounded hover treatment on toolbar iconbuttons. -->
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="json:JsonRow">
                        <!-- Transparent background keeps the full fixed-height row hit-testable
                             for the right-click copy handler even though the children are
                             vertically centered (and so shorter than the row). -->
                        <StackPanel Orientation="Horizontal"
                                    Background="Transparent"
                                    Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}"
                                    PointerPressed="OnRowPointerPressed"
                                    DoubleTapped="OnRowDoubleTapped">
                            <!-- Array-element ordinal, shown only on array children (null on
                                 object members and the root) - lets you see which index you're
                                 about to open without expanding it. Small and fixed-width so it
                                 doesn't affect the fixed 22px row height or shift the expander. -->
                            <TextBlock Text="{Binding ArrayIndex}"
                                       IsVisible="{Binding ArrayIndex, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                       FontSize="9"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       FontFamily="{DynamicResource AppContentFontFamily}"
                                       Width="26"
                                       TextAlignment="Right"
                                       Margin="0,0,2,0"
                                       VerticalAlignment="Center" />
                            <!-- Vector triangle, not a text glyph: a ▶/▼ character picks up
                                 font-fallback metrics that differ by platform (and even by glyph
                                 within the same fallback chain on Windows), so the two states
                                 rendered at visibly different sizes there. Geometry is a fixed
                                 size everywhere. -->
                            <!-- Button is full row height/wider than the glyph itself so the
                                 click target isn't shrunk down to the tiny triangle's bounds. -->
                            <Button Click="OnToggleExpandClick"
                                    IsVisible="{Binding HasChildren}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Width="20"
                                    Height="22"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                <Path Data="{Binding IsExpanded, Converter={x:Static json:ExpandGlyphConverter.Instance}}"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform"
                                      Width="7"
                                      Height="7" />
                            </Button>
                            <!-- Spacer standing in for the toggle on a leaf row. Must be exactly
                                 the button's width, or names on rows with a triangle sit
                                 indented relative to their leaf siblings at the same depth. -->
                            <TextBlock IsVisible="{Binding !HasChildren}"
                                       Width="20" />
                            <TextBlock search:SearchHighlight.Text="{Binding Name}"
                                       search:SearchHighlight.Suffix=": "
                                       search:SearchHighlight.Term="{Binding $parent[json:JsonView].((json:JsonViewModel)DataContext).HighlightTerm}"
                                       IsVisible="{Binding Name, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                       Foreground="{DynamicResource AppAccentBrush}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource AppContentFontFamily}" />
                            <TextBlock search:SearchHighlight.Text="{Binding Value}"
                                       search:SearchHighlight.Term="{Binding $parent[json:JsonView].((json:JsonViewModel)DataContext).HighlightTerm}"
                                       Classes.jsonString="{Binding IsStringValue}"
                                       Classes.jsonNumber="{Binding IsNumberValue}"
                                       Classes.jsonBool="{Binding IsBooleanValue}"
                                       Classes.jsonNull="{Binding IsNullValue}"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource AppContentFontFamily}" />
                            <TextBlock Text="{Binding TruncationHint}"
                                       IsVisible="{Binding ShowPlainTruncationHint}"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       FontFamily="{DynamicResource AppContentFontFamily}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                            <Button Classes="hintlink"
                                    Content="{Binding TruncationHint}"
                                    IsVisible="{Binding ShowTruncationLink}"
                                    Click="OnJumpToRawClick"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="View this value in the raw file" />
                            <Button Classes="hintlink"
                                    Content="{Binding Hint}"
                                    IsVisible="{Binding Hint, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                    Click="OnHintClick"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Decoded date (local time) — click to change scheme" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    Padding="8,4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="No selection"
                               FontSize="11"
                               VerticalAlignment="Center"
                               IsVisible="{Binding SelectedPath, Converter={x:Static json:IsNullConverter.Instance}}"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontFamily="{DynamicResource AppContentFontFamily}" />
                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding SelectedPathSegments}"
                                  IsVisible="{Binding SelectedPath, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="json:JsonPathSegment">
                                <Button Content="{Binding Label}"
                                        Click="OnPathSegmentClick"
                                        Classes="pathlink"
                                        FontSize="11"
                                        FontFamily="{DynamicResource AppContentFontFamily}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CopyValueButton"
                                Classes="iconbutton compact"
                                Click="OnCopyValueClick"
                                IsEnabled="{Binding SelectedPath, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                ToolTip.Tip="Copy value"
                                Margin="8,0,0,0">
                            <Viewbox Width="12" Height="12">
                                <Path Fill="{DynamicResource AppMutedTextBrush}"
                                      Data="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="CopyPathButton"
                                Classes="iconbutton compact"
                                Click="OnCopyPathClick"
                                IsEnabled="{Binding SelectedPath, Converter={x:Static json:IsNotNullConverter.Instance}}"
                                ToolTip.Tip="Copy JSONPath"
                                Margin="8,0,0,0">
                            <Viewbox Width="12" Height="12">
                                <Path Fill="{DynamicResource AppMutedTextBrush}"
                                      Data="M18 2H9a2 2 0 0 0-2 2v2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-2h2a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM14 20H5V8h9v12zm4-4h-2V8a2 2 0 0 0-2-2H9V4h9v12z" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
