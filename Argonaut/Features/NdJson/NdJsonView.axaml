<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:json="clr-namespace:Argonaut.Features.NdJson"
             xmlns:jsonview="clr-namespace:Argonaut.Features.Json"
             xmlns:find="clr-namespace:Argonaut.Ui.Find"
             x:Class="Argonaut.Features.NdJson.NdJsonView"
             x:DataType="json:NdJsonViewModel">
    <Border BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0"
            Background="{DynamicResource AppWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid ColumnDefinitions="*,1,*">
            <ListBox x:Name="JsonLinesListBox"
                     Grid.Column="0"
                     ItemsSource="{Binding Lines}"
                     SelectionMode="Single"
                     Padding="8,6">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Height" Value="22" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="json:NdJsonVisibleLine">
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding LineNumber}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,12,0"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       FontFamily="{DynamicResource AppContentFontFamily}" />
                            <TextBlock Grid.Column="1"
                                       find:SearchHighlight.Text="{Binding Text}"
                                       find:SearchHighlight.Term="{Binding $parent[json:NdJsonView].((json:NdJsonViewModel)DataContext).HighlightTerm}"
                                       TextWrapping="NoWrap"
                                       FontFamily="{DynamicResource AppContentFontFamily}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <GridSplitter Grid.Column="1"
                          Width="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource AppBorderBrush}" />

            <Border Grid.Column="2" Padding="0" Background="{DynamicResource AppPanelBackgroundBrush}">
                <Grid>
                    <ContentControl IsVisible="{Binding SelectedLineJsonViewModel, Converter={x:Static jsonview:IsNotNullConverter.Instance}}">
                        <jsonview:JsonView DataContext="{Binding SelectedLineJsonViewModel}" />
                    </ContentControl>
                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding SelectedLineJsonViewModel, Converter={x:Static jsonview:IsNullConverter.Instance}}">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                            <!-- Material "data_object" -->
                            <Path Fill="{DynamicResource AppSubtleIconBrush}"
                                  Data="M4 7v2c0 .55-.45 1-1 1H2v4h1c.55 0 1 .45 1 1v2c0 1.65 1.35 3 3 3h3v-2H7c-.55 0-1-.45-1-1v-2c0-1.3-.84-2.42-2-2.83v-.34C5.16 11.42 6 10.3 6 9V7c0-.55.45-1 1-1h3V4H7C5.35 4 4 5.35 4 7zM21 10c-.55 0-1-.45-1-1V7c0-1.65-1.35-3-3-3h-3v2h3c.55 0 1 .45 1 1v2c0 1.3.84 2.42 2 2.83v.34c-1.16.41-2 1.52-2 2.83v2c0 .55-.45 1-1 1h-3v2h3c1.65 0 3-1.35 3-3v-2c0-.55.45-1 1-1h1v-4h-1z" />
                        </Viewbox>
                        <TextBlock Text="Select a line to see it as a tree"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
