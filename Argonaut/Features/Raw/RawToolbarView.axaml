<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:raw="clr-namespace:Argonaut.Features.Raw"
             mc:Ignorable="d"
             x:Class="Argonaut.Features.Raw.RawToolbarView"
             x:DataType="raw:RawToolbarViewModel">
    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <ToggleButton x:Name="EditToggle"
                      IsChecked="{Binding IsEditing, Mode=TwoWay}"
                      IsEnabled="{Binding CanEdit}"
                      Classes="tool"
                      ToolTip.Tip="Type to change the document. Changes are held in memory until you save (Ctrl+S or Cmd+S).">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                    <!-- Material "edit" -->
                    <Path Fill="{Binding $parent[ToggleButton].Foreground}"
                          Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                </Viewbox>
                <TextBlock Text="Edit" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>
        <ComboBox x:Name="WrapWidthCombo"
                  SelectedIndex="{Binding WrapWidthIndex, Mode=TwoWay}"
                  IsEnabled="{Binding CanChangeWrapWidth}"
                  Classes="tool"
                  ToolTip.Tip="Force line breaks at this many bytes (re-indexes the file)">
            <ComboBoxItem Content="Wrap: 80 bytes" />
            <ComboBoxItem Content="Wrap: 160 bytes" />
            <ComboBoxItem Content="Wrap: 512 bytes" />
        </ComboBox>
        <ComboBox x:Name="ColoursCombo"
                  SelectedIndex="{Binding ColoursIndex, Mode=TwoWay}"
                  Classes="tool"
                  ToolTip.Tip="Syntax colours for this document">
            <ComboBoxItem Content="{Binding AutoColoursLabel}" />
            <ComboBoxItem Content="Off" />
            <ComboBoxItem Content="JSON" />
            <ComboBoxItem Content="Config" />
        </ComboBox>
    </StackPanel>
</UserControl>
