<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:raw="clr-namespace:Argonaut.Features.Raw"
             xmlns:editing="clr-namespace:Argonaut.Features.Raw.Editing"
             x:Class="Argonaut.Features.Raw.RawView"
             x:DataType="raw:RawViewModel">
    <Border BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource AppWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="*,Auto,Auto" ColumnDefinitions="*,Auto,Auto">
            <!-- The surface draws every visible row itself. The two scrollbars drive it through
                 RowScrollBars, as every self-drawn view's do: the vertical one over its rows, the
                 pan one over RawTextSurface.PanOffset, which moves the text and leaves both
                 gutters pinned. -->
            <raw:RawTextSurface x:Name="Surface"
                                Grid.Row="0"
                                Grid.Column="0"
                                Background="{DynamicResource AppWindowBackgroundBrush}"
                                FontFamily="{DynamicResource AppContentFontFamily}"
                                FontSize="{DynamicResource AppContentFontSize}"
                                Foreground="{DynamicResource AppTextBrush}"
                                GutterForeground="{DynamicResource AppMutedTextBrush}"
                                HighlightBrush="{DynamicResource AppSearchHighlightBrush}"
                                SelectionBrush="{DynamicResource AppAccentSurfaceBrush}"
                                CaretBrush="{DynamicResource AppTextBrush}" />

            <ScrollBar x:Name="VerticalScrollBar"
                       Grid.Row="0"
                       Grid.Column="1"
                       Orientation="Vertical"
                       IsVisible="False"
                       Minimum="0" />

            <!-- Where the edits are, on the scrollbar's scale: the inspector's piece-table bar
                 turned on its side. Shown only once there is an editor. -->
            <editing:RawEditOverview x:Name="EditOverview"
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 Width="8"
                                 IsVisible="False"
                                 MarkBrush="{DynamicResource AppEditMarkBrush}" />

            <ScrollBar x:Name="PanScrollBar"
                       Grid.Row="1"
                       Orientation="Horizontal"
                       AllowAutoHide="False"
                       IsVisible="False"
                       Minimum="0" />

            <!-- Status gutter: the character under the caret on the left, where the caret is on
                 the right, split by a rule. Same chrome as the JSON diff view's context bar - a
                 panel-coloured strip under a top border - so a reader recognises it as the view
                 talking about its selection rather than as part of the document. -->
            <Border Grid.Row="2"
                    Grid.ColumnSpan="3"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    Padding="8,4">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               x:Name="CaretCharacterText"
                               Text="{Binding CaretCharacterText}"
                               FontSize="11"
                               FontFamily="{DynamicResource AppContentFontFamily}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1"
                            Width="1"
                            Margin="12,1"
                            Background="{DynamicResource AppBorderBrush}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="EditStatusText"
                                   Text="{Binding EditStatusText}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource AppContentFontFamily}"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CaretSelectionText"
                                   Text="{Binding CaretSelectionText}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource AppContentFontFamily}"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CaretPositionText"
                                   Text="{Binding CaretPositionText}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource AppContentFontFamily}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
