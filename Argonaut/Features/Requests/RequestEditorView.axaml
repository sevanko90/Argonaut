<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:requests="clr-namespace:Argonaut.Features.Requests"
             xmlns:raw="clr-namespace:Argonaut.Features.Raw"
             xmlns:icons="clr-namespace:Argonaut.Ui.Icons"
             x:Class="Argonaut.Features.Requests.RequestEditorView"
             x:DataType="requests:RequestEditorViewModel">
    <UserControl.Styles>
        <Style Selector="Button.paneicon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="Button.paneicon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBackgroundBrush}" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.status.problem">
            <Setter Property="Foreground" Value="{DynamicResource AppDangerHoverBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox.argument">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </UserControl.Styles>

    <!-- The request: method and URL on one line, then (unless folded) the URL's arguments and,
         for POST, the body. The response opens as the document below this pane. -->
    <Border Background="{DynamicResource AppChromeBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding MethodNames}"
                          SelectedIndex="{Binding MethodIndex, Mode=TwoWay}"
                          MinWidth="84"
                          VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         x:Name="UrlBox"
                         Text="{Binding UrlText, Mode=TwoWay}"
                         PlaceholderText="https://api.example.com/items?page=1"
                         FontFamily="{DynamicResource AppMonoFontFamily}"
                         KeyDown="OnUrlKeyDown"
                         VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="Send"
                        Classes="accent"
                        IsEnabled="{Binding CanSend}"
                        Click="OnSend"
                        VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        Classes="paneicon"
                        ToolTip.Tip="Fold the request away"
                        Click="OnToggleCollapsed">
                    <icons:LucideIcon x:Name="FoldIcon" Data="{StaticResource Icon.ChevronUp}" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <TextBlock Text="{Binding StatusText}"
                       Classes="status"
                       Classes.problem="{Binding IsStatusAProblem}"
                       IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}"
                       FontSize="12"
                       TextWrapping="Wrap" />

            <StackPanel Spacing="4" IsVisible="{Binding !IsCollapsed}">
                <TextBlock Text="Query arguments" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppMutedTextBrush}" />
                <ItemsControl ItemsSource="{Binding Arguments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="requests:QueryArgumentRowViewModel">
                            <Grid ColumnDefinitions="2*,3*,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                                <TextBox Classes="argument" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="key" />
                                <TextBox Grid.Column="1" Classes="argument" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" />
                                <Button Grid.Column="2" Classes="paneicon" ToolTip.Tip="Remove this argument"
                                        Click="OnRemoveArgument">
                                    <icons:LucideIcon Data="{StaticResource Icon.Close}" Size="13" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="linklike" Content="+ Add argument" FontSize="12" Click="OnAddArgument" HorizontalAlignment="Left" />

                <StackPanel Spacing="4" IsVisible="{Binding HasBody}" Margin="0,6,0,0">
                    <TextBlock Text="Body" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <Border Height="160"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <raw:RawView DataContext="{Binding Body.Editor}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
