<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dialogs="clr-namespace:Argonaut.Shell.Dialogs"
        mc:Ignorable="d"
        x:Class="Argonaut.Shell.Dialogs.NoticesDialog"
        Title="Licenses and third-party notices"
        Width="860" Height="620"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">
    <Grid Margin="16" RowDefinitions="*,Auto" ColumnDefinitions="220,12,*">
        <ListBox x:Name="ComponentListBox"
                 Grid.Row="0" Grid.Column="0"
                 SelectionMode="Single"
                 SelectionChanged="OnComponentSelected"
                 Background="{DynamicResource AppPanelBackgroundBrush}"
                 BorderBrush="{DynamicResource AppBorderBrush}"
                 BorderThickness="1"
                 CornerRadius="8">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dialogs:LicenseNotice">
                    <TextBlock Text="{Binding Component}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="0" Grid.Column="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Margin="16,12" Spacing="2">
                    <TextBlock x:Name="ComponentText" FontSize="16" FontWeight="SemiBold" />
                    <Button x:Name="HomepageLinkButton"
                            Click="OnHomepageLinkClicked"
                            Classes="linklike"
                            HorizontalAlignment="Left" />
                    <TextBlock x:Name="PackagesText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                </StackPanel>
                <!-- Notices are hard-wrapped at ~80 columns by their authors, so no wrapping here:
                     scroll sideways for the odd long line rather than reflowing ASCII layouts. -->
                <ScrollViewer x:Name="NoticeScrollViewer"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock x:Name="NoticeText"
                                         Margin="16,0,16,16"
                                         FontFamily="{DynamicResource AppMonoFontFamily}"
                                         FontSize="12" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Button Grid.Row="1" Grid.Column="2"
                Content="Close"
                Click="OnClose"
                Classes="accent"
                HorizontalAlignment="Right"
                Margin="0,12,0,0" />
    </Grid>
</Window>
