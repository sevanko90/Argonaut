<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        x:Class="Argonaut.Shell.Dialogs.UnsavedChangesDialog"
        Title="Unsaved changes"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />
        <TextBlock Text="Your changes will be lost if you don't save them."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource AppMutedTextBrush}" />
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" x:Name="DiscardButton" Content="Don't Save" Click="OnDiscard" />
            <Button Grid.Column="2" x:Name="CancelButton" Content="Cancel" Click="OnCancel" Margin="0,0,8,0" />
            <Button Grid.Column="3" x:Name="SaveButton" Content="Save" Click="OnSave" Classes="accent" />
        </Grid>
    </StackPanel>
</Window>
