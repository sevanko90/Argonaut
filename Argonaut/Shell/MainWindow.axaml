<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Argonaut.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        xmlns:shell="clr-namespace:Argonaut.Shell"
        xmlns:find="clr-namespace:Argonaut.Ui.Find"
        xmlns:json="clr-namespace:Argonaut.Features.Json"
        xmlns:arrayTable="clr-namespace:Argonaut.Features.Json.ArrayTable"
        xmlns:diff="clr-namespace:Argonaut.Features.Json.Diff"
        xmlns:ndjson="clr-namespace:Argonaut.Features.NdJson"
        xmlns:csv="clr-namespace:Argonaut.Features.Csv"
        xmlns:raw="clr-namespace:Argonaut.Features.Raw"
        xmlns:progress="clr-namespace:Argonaut.Ui.Progress"
        xmlns:icons="clr-namespace:Argonaut.Ui.Icons"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        Title="{Binding Title}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52"
        Background="{DynamicResource AppPanelBackgroundBrush}"
        Width="1000" Height="700">

    <Window.DataTemplates>
        <DataTemplate DataType="json:JsonViewModel">
            <json:JsonView />
        </DataTemplate>
        <DataTemplate DataType="ndjson:NdJsonViewModel">
            <ndjson:NdJsonView />
        </DataTemplate>
        <DataTemplate DataType="csv:CsvViewModel">
            <csv:CsvView />
        </DataTemplate>
        <DataTemplate DataType="raw:RawViewModel">
            <raw:RawView />
        </DataTemplate>
        <DataTemplate DataType="diff:JsonDiffViewModel">
            <diff:JsonDiffView />
        </DataTemplate>
        <DataTemplate DataType="arrayTable:JsonArrayTableViewModel">
            <arrayTable:JsonArrayTableView />
        </DataTemplate>
        <DataTemplate DataType="json:JsonToolbarViewModel">
            <json:JsonToolbarView />
        </DataTemplate>
        <DataTemplate DataType="diff:JsonDiffToolbarViewModel">
            <diff:JsonDiffToolbarView />
        </DataTemplate>
        <DataTemplate DataType="raw:RawToolbarViewModel">
            <raw:RawToolbarView />
        </DataTemplate>
        <DataTemplate DataType="arrayTable:JsonArrayTableToolbarViewModel">
            <arrayTable:JsonArrayTableToolbarView />
        </DataTemplate>
        <DataTemplate DataType="shell:IncompatibleViewModel">
            <shell:IncompatibleView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The title bar and the toolbar are one strip, as in a native unified toolbar: the
             client area extends under the window controls (ExtendClientAreaToDecorationsHint),
             the strip's background is the drag region, and the controls on it stay clickable.
             MainWindow pads it clear of the platform's window buttons - traffic lights on the
             left on macOS, caption buttons on the right elsewhere.

             Left to right: what is open, then the open view's own options, the document
             actions, and search last, where a desktop app keeps it. -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                Height="52"
                Background="{DynamicResource AppChromeBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- What is open, with its close button beside the name as a tab's would be. The
                     one column that gives way when the strip is short: the name truncates before
                     any control is clipped. The badge and name are hit-test transparent so they drag
                     the window like the rest of the strip; the full path and size stay in the
                     status bar. -->
                <DockPanel Grid.Column="0"
                           LastChildFill="True"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0">
                    <Border DockPanel.Dock="Left"
                            IsHitTestVisible="False"
                            Background="{DynamicResource AppAccentSurfaceBrush}"
                            CornerRadius="6"
                            Margin="0,0,8,0"
                            Width="24" Height="24">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="1.8"
                              Data="M8 3H5V9L2 12L5 15V21H8 M16 3H19V9L22 12L19 15V21H16" />
                    </Border>
                    <!-- Left-aligned, so the close button sits right after the name rather than at
                         the far end of the column, and the name's star column truncates it. -->
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding HeaderTitle}"
                                   IsVisible="{Binding IsFileOpen}"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Argonaut"
                                   IsVisible="{Binding !IsFileOpen}"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                x:Name="CloseFileButton"
                                Classes="tool"
                                IsVisible="{Binding IsFileOpen}"
                                Click="OnCloseFile"
                                MinHeight="0"
                                Width="22" Height="22"
                                Padding="0"
                                Margin="6,0,0,0"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Close file">
                            <icons:LucideIcon Data="{StaticResource Icon.Close}" Size="13" />
                        </Button>
                    </Grid>
                </DockPanel>

                <!-- The open view's own options (expand depth, schema, wrap width...). -->
                <ContentControl Grid.Column="1"
                                x:Name="DocumentToolbarArea"
                                IsVisible="{Binding IsFileOpen}"
                                Content="{Binding CurrentDocument.Toolbar, FallbackValue={x:Null}}"
                                VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsFileOpen}">
                    <Border Classes="toolseparator"
                            IsVisible="{Binding CurrentDocument.Toolbar, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                    <Button x:Name="CompareFileButton"
                            Classes="tool icononly"
                            IsVisible="{Binding CanCompare}"
                            Click="OnCompareFile"
                            ToolTip.Tip="Compare with another JSON file…">
                        <icons:LucideIcon Data="{StaticResource Icon.Compare}" />
                    </Button>
                    <!-- A split button made of two, rather than Avalonia's SplitButton: that control
                         disables its dropdown along with its primary half, and here the halves must
                         differ - Save needs unsaved changes, Save As only a document ready to write. -->
                    <StackPanel x:Name="SaveButtons"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsSaveAvailable}">
                        <Button x:Name="SaveFileButton"
                                Classes="tool icononly"
                                IsEnabled="{Binding CanSave}"
                                Click="OnSaveFile"
                                CornerRadius="6,0,0,6"
                                ToolTip.Tip="Save changes (Ctrl+S / Cmd+S)">
                            <icons:LucideIcon Data="{StaticResource Icon.Save}" />
                        </Button>
                        <Button x:Name="SaveOptionsButton"
                                Classes="tool"
                                IsEnabled="{Binding CanSaveAs}"
                                CornerRadius="0,6,6,0"
                                Padding="4,4"
                                ToolTip.Tip="More ways to save">
                            <icons:LucideIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Save As…" Click="OnSaveFileAs" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <!-- Before search only when something sits to its left to divide it from. -->
                    <Border Classes="toolseparator">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsFindAvailable" />
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding Path="CurrentDocument.Toolbar" Converter="{x:Static ObjectConverters.IsNotNull}" FallbackValue="False" />
                                    <Binding Path="CanCompare" />
                                    <Binding Path="IsSaveAvailable" />
                                </MultiBinding>
                            </MultiBinding>
                        </Border.IsVisible>
                    </Border>
                </StackPanel>

                <find:FindBar Grid.Column="3"
                              x:Name="FindBarControl"
                              Margin="6,0,0,0"
                              IsVisible="{Binding IsFindAvailable}"
                              VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    x:Name="FailureBanner"
                    IsVisible="{Binding IsFailureBannerVisible}"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                        <!-- Material "warning" -->
                        <Path Fill="{DynamicResource AppDangerHoverBrush}"
                              Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
                    </Viewbox>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentDocument.StatusText, FallbackValue={x:Null}}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <Button Grid.Column="2"
                            x:Name="JumpToFailureLineButton"
                            Content="Jump to line"
                            IsVisible="{Binding CanJumpToFailureLocation}"
                            Click="OnJumpToFailureLine"
                            Classes="linklike"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Jump to this location in the raw viewer" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            x:Name="ContentArea"
                            Content="{Binding CurrentDocument}" />
        </Grid>

        <shell:EmptyStateView Grid.Row="1"
                              x:Name="EmptyState"
                              IsVisible="{Binding !IsFileOpen}" />

        <!-- Work in progress: shown only for operations that outlast ProgressBoard.ShowAfter, kept
             for at least ShowAtLeast, and faded rather than snapped away - so the everyday
             instant operations never flash it. The fade length matches ProgressBoard.FadeOut. -->
        <Border Grid.Row="1"
                x:Name="ProgressCard"
                Classes="progressCard"
                Classes.shown="{Binding Progress.IsVisible}"
                IsHitTestVisible="{Binding Progress.IsVisible}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="340"
                Margin="0,0,16,16"
                Padding="12,8"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppPanelBackgroundBrush}">
            <Border.Styles>
                <Style Selector="Border.progressCard">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Border.progressCard.shown">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </Border.Styles>
            <ItemsControl ItemsSource="{Binding Progress.Shown}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="progress:ProgressEntry">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,4">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Percent, StringFormat={}{0}%}"
                                       IsVisible="{Binding !IsIndeterminate}"
                                       FontSize="12"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                    Content="Stop"
                                    IsVisible="{Binding CanStop}"
                                    Click="OnStopProgress"
                                    FontSize="11"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                         Value="{Binding Percent, FallbackValue=0}"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Minimum="0" Maximum="100"
                                         MinHeight="4" Height="4"
                                         Margin="0,6,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="1"
                x:Name="ToastBorder"
                IsVisible="False"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                Padding="12,6"
                CornerRadius="6"
                Background="{DynamicResource AppAccentBrush}">
            <TextBlock x:Name="ToastText"
                       Foreground="White"
                       FontSize="12" />
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource AppChromeBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Height="30"
                Padding="12,0,8,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text="{Binding StatusText}"
                           ToolTip.Tip="{Binding FilePath}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMutedTextBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <ComboBox x:Name="ViewSwitcherComboBox"
                              IsVisible="{Binding IsFileOpen}"
                              ItemsSource="{Binding AvailableViews}"
                              SelectedItem="{Binding SelectedView, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              Classes="tool"
                              FontSize="11"
                              MinHeight="22"
                              Height="22"
                              Padding="8,0,0,0"
                              ToolTip.Tip="Change how this file is displayed" />
                    <Button x:Name="FontToggleButton"
                            Click="OnToggleContentFont"
                            Classes="iconbutton compact">
                        <icons:LucideIcon Data="{StaticResource Icon.ContentFont}" Size="14" />
                    </Button>
                    <Button x:Name="ThemeToggleButton"
                            Click="OnToggleTheme"
                            Classes="iconbutton compact">
                        <icons:LucideIcon x:Name="ThemeToggleIcon" Size="14" />
                    </Button>
                    <Button x:Name="CheckForUpdatesButton"
                            Click="OnCheckForUpdates"
                            Classes="iconbutton compact"
                            ToolTip.Tip="Check for updates">
                        <icons:LucideIcon Data="{StaticResource Icon.Download}" Size="14" />
                    </Button>
                    <!-- Debug builds only: shown when App hands the window a way to open the log
                         folder (see MainWindow's constructor). -->
                    <Button x:Name="OpenLogFolderButton"
                            Click="OnOpenLogFolder"
                            IsVisible="False"
                            Classes="iconbutton compact"
                            ToolTip.Tip="Open the debug log folder">
                        <icons:LucideIcon Data="{StaticResource Icon.Folder}" Size="14" />
                    </Button>
                    <Button x:Name="AboutButton"
                            Click="OnShowAbout"
                            Classes="iconbutton compact"
                            ToolTip.Tip="About Argonaut">
                        <icons:LucideIcon Data="{StaticResource Icon.About}" Size="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
