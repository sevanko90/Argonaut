            <SolidColorBrush x:Key="TableViewRowBackgroundSelected" Color="#25334A" />
            <SolidColorBrush x:Key="TableViewRowBackgroundSelectedPointerOver" Color="#25334A" />
            <SolidColorBrush x:Key="TableViewRowBackgroundSelectedPressed" Color="#25334A" />
