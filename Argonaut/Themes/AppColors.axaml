            <SolidColorBrush x:Key="TableViewColumnHeaderSeparatorBackground" Color="#2F3138" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Control metrics: 28px controls with 6px corners, the density of a native desktop
         toolbar rather than Fluent's touch-sized defaults. A focused field gets a 1px accent
         ring, not Fluent's heavy underline. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
    <x:Double x:Key="ComboBoxMinHeight">28</x:Double>
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <Thickness x:Key="TextControlThemePadding">8,4,8,4</Thickness>
    <Thickness x:Key="ButtonPadding">10,4,10,4</Thickness>
    <Thickness x:Key="ComboBoxPadding">10,4,8,4</Thickness>

</ResourceDictionary>
