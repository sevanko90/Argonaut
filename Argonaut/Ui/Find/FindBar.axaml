<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:icons="clr-namespace:Argonaut.Ui.Icons"
             x:Class="Argonaut.Ui.Find.FindBar">
    <UserControl.Styles>
        <!-- The field's own buttons: small, borderless, inside the field's edge. -->
        <Style Selector="Button.infield">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.infield:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBackgroundBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- One search field, as a native search box is: the magnifier, the term, the match count
         and the previous/next/clear buttons all sit inside its border, so find reads as a
         single control rather than a field with buttons floating beside it. -->
    <TextBox x:Name="TermBox"
             Width="220"
             FontSize="12"
             MinHeight="28"
             Padding="2,4,4,4"
             PlaceholderText="Find"
             FontFamily="{DynamicResource AppContentFontFamily}">
        <TextBox.InnerLeftContent>
            <icons:LucideIcon Data="{StaticResource Icon.Search}"
                              Size="13"
                              Margin="10,0,4,0"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource AppSubtleIconBrush}" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,2,0">
                <TextBlock x:Name="StatusLabel"
                           FontSize="11"
                           Margin="4,0,4,0"
                           VerticalAlignment="Center"
                           MaxWidth="130"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource AppSansFontFamily}"
                           Foreground="{DynamicResource AppMutedTextBrush}" />
                <Button x:Name="PreviousButton"
                        Classes="infield"
                        ToolTip.Tip="Previous match (Shift+Enter)">
                    <icons:LucideIcon Data="{StaticResource Icon.ChevronUp}" Size="13" Foreground="{DynamicResource AppMutedTextBrush}" />
                </Button>
                <Button x:Name="NextButton"
                        Classes="infield"
                        ToolTip.Tip="Next match (Enter)">
                    <icons:LucideIcon Data="{StaticResource Icon.ChevronDown}" Size="13" Foreground="{DynamicResource AppMutedTextBrush}" />
                </Button>
                <Button x:Name="CloseButton"
                        Classes="infield"
                        ToolTip.Tip="Clear search (Esc)">
                    <icons:LucideIcon Data="{StaticResource Icon.Close}" Size="12" Foreground="{DynamicResource AppMutedTextBrush}" />
                </Button>
            </StackPanel>
        </TextBox.InnerRightContent>
    </TextBox>
</UserControl>
