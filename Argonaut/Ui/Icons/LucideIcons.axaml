<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The app's one icon set: Lucide (lucide.dev, ISC licence - see THIRD-PARTY-NOTICES.txt),
         outlines on a 24x24 grid, drawn stroked by LucideIcon rather than filled. Circles, rects,
         lines and polylines are converted to path data so every icon is a single geometry. Key by
         role, not by Lucide's name, so swapping a glyph is a one-line change here. -->
    <!-- Lucide "calendar-clock" -->
    <StreamGeometry x:Key="Icon.Hints">M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5 M16 2v4 M8 2v4 M3 10h5 M17.5 17.5 16 16.3V14 M10,16 A6,6 0 1 0 22,16 A6,6 0 1 0 10,16 Z</StreamGeometry>
